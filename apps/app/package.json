{
  "name": "@voidbinder/app",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "EXPO_PUBLIC_API_URL=http://localhost:8787 expo start --web",
    "build": "expo export --platform web && node scripts/write-headers.ts",
    "typecheck": "wrangler types && tsc --noEmit && tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "test": "vitest run",
    "deploy:dev": "pnpm run build && wrangler deploy --env dev",
    "deploy:prod": "pnpm run build && wrangler deploy --env prod"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@tanstack/react-query": "^5.104.1",
    "@voidbinder/api": "workspace:*",
    "@voidbinder/core": "workspace:*",
    "@voidbinder/shared": "workspace:*",
    "@voidbinder/tokens": "workspace:*",
    "expo": "^57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.14",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "wrangler": "^4.149.0"
  }
}
