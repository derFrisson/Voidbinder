{
  "extends": ["expo/tsconfig.base", "../../tsconfig.base.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "customConditions": ["react-native"],
    "allowJs": false,
    "types": ["node"]
  },
  "include": ["src", "test", "*.ts", "nativewind-env.d.ts"],
  "exclude": ["src/worker.ts", "src/worker.test.ts", "node_modules", "dist"]
}
