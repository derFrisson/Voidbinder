# Local overrides and secrets for `pnpm --filter api dev`: `cp .dev.vars.example .dev.vars`
# (gitignored). Values here override the top-level `vars` in wrangler.jsonc.
APP_URL=http://localhost:8081
# Better Auth signing and encryption key, 32+ bytes: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-local-only-0123456789abcdef
# Bearer token of /admin/** (POST /admin/import/scryfall). Deployed environments:
# openssl rand -base64 32 | pnpm exec wrangler secret put ADMIN_TOKEN --env dev|prod
ADMIN_TOKEN=local-dev-admin-token
# Encrypts the two-factor secrets at rest (AES-256-GCM), 32 bytes in base64: `openssl rand -base64 32`.
# Changing it makes every enrolled authenticator and backup code unreadable.
TWO_FACTOR_ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHktdHdvLWZhY3Rvci1rZXkhISE=
# Turnstile (VB-72). Cloudflare's always-passes test secret; with IMPORT_ENV=local (the top-level
# wrangler vars) the API then skips the check entirely, so no token is needed locally. Deployed
# environments hold the real secret: wrangler secret put TURNSTILE_SECRET --env dev|prod
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Optional (VB-118): a pokemontcg.io key for the Pokémon pictures TCGdex lacks, sent as X-Api-Key
# (20,000 requests a day instead of 1,000). Deployed: wrangler secret put POKEMONTCG_API_KEY --env dev|prod
# POKEMONTCG_API_KEY=
