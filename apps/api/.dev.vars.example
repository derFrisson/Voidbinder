# Local overrides and secrets for `pnpm --filter api dev`: `cp .dev.vars.example .dev.vars`
# (gitignored). Values here override the top-level `vars` in wrangler.jsonc.
APP_URL=http://localhost:8081
# Better Auth signing and encryption key, 32+ bytes: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=change-me-local-only-0123456789abcdef
