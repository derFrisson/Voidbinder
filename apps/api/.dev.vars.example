# Local overrides for `pnpm --filter api dev`: `cp .dev.vars.example .dev.vars` (gitignored).
# Values here override the top-level `vars` in wrangler.jsonc. Any value works locally.
APP_URL=http://localhost:8081
# Bearer token of /admin/** (POST /admin/import/scryfall). Deployed environments:
# openssl rand -base64 32 | pnpm exec wrangler secret put ADMIN_TOKEN --env dev|prod
ADMIN_TOKEN=local-dev-admin-token
