// Cloudflare config for the Voidbinder API (docs/environments.md). The top level is what
// `wrangler dev` uses locally; `--env dev|prod` selects a deployed environment. Bindings and vars
// are not inherited by environments, so they are repeated in each one.
//
// CORS_EXTRA_ORIGINS (comma-separated) admits origins besides APP_URL in CORS and Better Auth:
// the Expo web dev server, locally and in dev only. env.prod must never set it (app.test.ts).
//
// VERSION is "local" here and set to the short git sha by the deploy:dev / deploy:prod scripts
// (`wrangler deploy --var VERSION:<sha>`); GET /health reports it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "152a1fcd0eebb96d1bc30d14b5a6af58",
  "name": "voidbinder-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Workers Caching (VB-71, README "Caching"): GET/HEAD responses are cached per their
  // Cache-Control, so only the catalog, price and module routes (public) are stored; everything
  // else sends no-store. Repeated in every env like the bindings.
  "cache": { "enabled": true },
  "workers_dev": false,
  "vars": {
    "APP_URL": "http://localhost:8081",
    "API_URL": "http://localhost:8787",
    "CORS_EXTRA_ORIGINS": "http://localhost:8081",
    "IMAGE_BASE_URL": "https://img.voidbinder.de",
    "SCRYFALL_LANGUAGES": "en,de",
    // Prefix of the import's R2 keys (raw/<env>/…, work/<env>/…): local, dev or prod.
    "IMPORT_ENV": "local",
    "VERSION": "local",
    // Turnstile (VB-72): the widget's public sitekey (one widget for every hostname; the web app
    // and the site embed it too; the API only verifies tokens with TURNSTILE_SECRET) and the
    // Sprint 3 switch for native clients ("true": a request with an Authorization: Bearer header
    // skips the check). Locally Cloudflare's always-passes test key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_NATIVE_BYPASS": "false",
  },
  // Locally from .dev.vars (see .dev.vars.example); deployed: wrangler secret put --env dev|prod.
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "ADMIN_TOKEN",
      "TWO_FACTOR_ENCRYPTION_KEY",
      "TURNSTILE_SECRET",
    ],
  },
  // Auth mails (verification, password reset); `wrangler dev` simulates the binding locally.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@voidbinder.de"] }],
  // Search index (VB-98, ADR 0006): D1 copy of the names and codes the typeahead and the search
  // read, refreshed from Postgres by SEARCH_INDEX_REFRESH. Migrations in d1/, applied by
  // deploy:dev / deploy:prod. Locally `wrangler dev` simulates it under .wrangler/state.
  "d1_databases": [
    {
      "binding": "SEARCH",
      "database_name": "voidbinder-search-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "d1",
    },
  ],
  // Local Postgres from the root docker-compose.yml. HYPERDRIVE is cache-disabled (fresh reads);
  // HYPERDRIVE_CACHED caches reads for 300 s and serves catalog and price reads only (ADR 0004).
  // Locally both point at the same database and nothing is cached.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
    },
    {
      "binding": "HYPERDRIVE_CACHED",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
    },
  ],
  // Locally `wrangler dev` simulates the buckets under .wrangler/state. CATALOG is public through
  // img.voidbinder.de and holds images/ only; RAW is private (raw/ dumps, work/ chunks).
  "r2_buckets": [
    { "binding": "CATALOG", "bucket_name": "voidbinder-catalog", "jurisdiction": "eu" },
    { "binding": "RAW", "bucket_name": "voidbinder-raw", "jurisdiction": "eu" },
  ],
  // Catalog import (VB-26, VB-27, VB-28) and TCGCSV prices (VB-30): one Workflow per source
  // (Scryfall, YGOPRODeck, TCGdex, TCGCSV, Yugipedia's translations, VB-93); each cron starts one
  // daily, Yugipedia's weekly (CRON_SOURCES in src/import/schedule.ts maps the expression), and
  // POST /admin/import/<source> on demand; dev has no TCGCSV cron (TCGCSV asks for one pull a day;
  // prod's 22:30 run only reads last-updated.txt when 20:30 imported the build). Splitting the
  // 2 GB Scryfall all_cards dump needs more than the default 30 s of CPU in one step.
  "workflows": [
    {
      "binding": "SCRYFALL_IMPORT",
      "name": "voidbinder-scryfall-import",
      "class_name": "ScryfallImportWorkflow",
    },
    {
      "binding": "YGOPRODECK_IMPORT",
      "name": "voidbinder-ygoprodeck-import",
      "class_name": "YgoprodeckImportWorkflow",
    },
    {
      "binding": "TCGDEX_IMPORT",
      "name": "voidbinder-tcgdex-import",
      "class_name": "TcgdexImportWorkflow",
    },
    {
      "binding": "TCGCSV_IMPORT",
      "name": "voidbinder-tcgcsv-import",
      "class_name": "TcgcsvImportWorkflow",
    },
    {
      "binding": "YUGIPEDIA_IMPORT",
      "name": "voidbinder-yugipedia-import",
      "class_name": "YugipediaImportWorkflow",
    },
    {
      "binding": "SEARCH_INDEX_REFRESH",
      "name": "voidbinder-search-index-refresh",
      "class_name": "SearchIndexRefreshWorkflow",
    },
  ],
  "triggers": {
    "crons": ["0 3 * * *", "30 3 * * *", "0 4 * * *", "30 20 * * *", "30 22 * * *", "30 4 * * 1"],
  },
  // The image delta adds up to ~4000 subrequests (a fetch and an R2 put per image) to an import
  // instance on top of the import's own; the default is 10,000 per instance.
  "limits": { "cpu_ms": 300000, "subrequests": 50000 },
  "env": {
    "dev": {
      "name": "voidbinder-api-dev",
      "workers_dev": true,
      "cache": { "enabled": true },
      "vars": {
        "APP_URL": "https://voidbinder-app-dev.frisson.workers.dev",
        "API_URL": "https://voidbinder-api-dev.frisson.workers.dev",
        "CORS_EXTRA_ORIGINS": "http://localhost:8081",
        "IMAGE_BASE_URL": "https://img.voidbinder.de",
        "SCRYFALL_LANGUAGES": "en,de",
        "IMPORT_ENV": "dev",
        "VERSION": "local",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFS5R7qPne3TN2Nz",
        "TURNSTILE_NATIVE_BYPASS": "false",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "ADMIN_TOKEN",
          "TWO_FACTOR_ENCRYPTION_KEY",
          "TURNSTILE_SECRET",
        ],
      },
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@voidbinder.de"] }],
      "d1_databases": [
        {
          "binding": "SEARCH",
          "database_name": "voidbinder-search-dev",
          "database_id": "11307070-42cd-4207-bf31-37dc06cf0335",
          "migrations_dir": "d1",
        },
      ],
      "hyperdrive": [
        // Hyperdrive config "voidbinder-dev" (database voidbinder_dev, caching disabled).
        {
          "binding": "HYPERDRIVE",
          "id": "6f5b0953850f4b7b99450961849113ab",
          "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
        },
        // Hyperdrive config "voidbinder-dev-cached" (same database, max_age 300 s).
        {
          "binding": "HYPERDRIVE_CACHED",
          "id": "80164a75f1224f34a30fc31f0dac35ca",
          "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
        },
      ],
      "r2_buckets": [
        { "binding": "CATALOG", "bucket_name": "voidbinder-catalog", "jurisdiction": "eu" },
        { "binding": "RAW", "bucket_name": "voidbinder-raw", "jurisdiction": "eu" },
      ],
      "workflows": [
        {
          "binding": "SCRYFALL_IMPORT",
          "name": "voidbinder-scryfall-import-dev",
          "class_name": "ScryfallImportWorkflow",
        },
        {
          "binding": "YGOPRODECK_IMPORT",
          "name": "voidbinder-ygoprodeck-import-dev",
          "class_name": "YgoprodeckImportWorkflow",
        },
        {
          "binding": "TCGDEX_IMPORT",
          "name": "voidbinder-tcgdex-import-dev",
          "class_name": "TcgdexImportWorkflow",
        },
        {
          "binding": "TCGCSV_IMPORT",
          "name": "voidbinder-tcgcsv-import-dev",
          "class_name": "TcgcsvImportWorkflow",
        },
        {
          "binding": "YUGIPEDIA_IMPORT",
          "name": "voidbinder-yugipedia-import-dev",
          "class_name": "YugipediaImportWorkflow",
        },
        {
          "binding": "SEARCH_INDEX_REFRESH",
          "name": "voidbinder-search-index-refresh-dev",
          "class_name": "SearchIndexRefreshWorkflow",
        },
      ],
      "triggers": { "crons": ["30 4 * * *", "0 5 * * *", "30 5 * * *", "0 6 * * 1"] },
      "limits": { "cpu_ms": 300000, "subrequests": 50000 },
    },
    "prod": {
      "name": "voidbinder-api",
      "workers_dev": false,
      "cache": { "enabled": true },
      "routes": [{ "pattern": "api.voidbinder.de", "custom_domain": true }],
      "vars": {
        "APP_URL": "https://app.voidbinder.de",
        "API_URL": "https://api.voidbinder.de",
        "IMAGE_BASE_URL": "https://img.voidbinder.de",
        "SCRYFALL_LANGUAGES": "en,de",
        "IMPORT_ENV": "prod",
        "VERSION": "local",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFS5R7qPne3TN2Nz",
        "TURNSTILE_NATIVE_BYPASS": "false",
      },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "ADMIN_TOKEN",
          "TWO_FACTOR_ENCRYPTION_KEY",
          "TURNSTILE_SECRET",
        ],
      },
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@voidbinder.de"] }],
      "d1_databases": [
        {
          "binding": "SEARCH",
          "database_name": "voidbinder-search-prod",
          "database_id": "6aee7e3a-f258-47a3-9d9d-42e565e9ae57",
          "migrations_dir": "d1",
        },
      ],
      "hyperdrive": [
        // Hyperdrive config "voidbinder-prod" (database voidbinder, caching disabled).
        {
          "binding": "HYPERDRIVE",
          "id": "2f4e2569cde54e0998b734c884432765",
          "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
        },
        // Hyperdrive config "voidbinder-prod-cached" (same database, max_age 300 s).
        {
          "binding": "HYPERDRIVE_CACHED",
          "id": "095f0ec41117431c8b29eec7134dde62",
          "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
        },
      ],
      "r2_buckets": [
        { "binding": "CATALOG", "bucket_name": "voidbinder-catalog", "jurisdiction": "eu" },
        { "binding": "RAW", "bucket_name": "voidbinder-raw", "jurisdiction": "eu" },
      ],
      "workflows": [
        {
          "binding": "SCRYFALL_IMPORT",
          "name": "voidbinder-scryfall-import",
          "class_name": "ScryfallImportWorkflow",
        },
        {
          "binding": "YGOPRODECK_IMPORT",
          "name": "voidbinder-ygoprodeck-import",
          "class_name": "YgoprodeckImportWorkflow",
        },
        {
          "binding": "TCGDEX_IMPORT",
          "name": "voidbinder-tcgdex-import",
          "class_name": "TcgdexImportWorkflow",
        },
        {
          "binding": "TCGCSV_IMPORT",
          "name": "voidbinder-tcgcsv-import",
          "class_name": "TcgcsvImportWorkflow",
        },
        {
          "binding": "YUGIPEDIA_IMPORT",
          "name": "voidbinder-yugipedia-import",
          "class_name": "YugipediaImportWorkflow",
        },
        {
          "binding": "SEARCH_INDEX_REFRESH",
          "name": "voidbinder-search-index-refresh",
          "class_name": "SearchIndexRefreshWorkflow",
        },
      ],
      "triggers": {
        "crons": [
          "0 3 * * *",
          "30 3 * * *",
          "0 4 * * *",
          "30 20 * * *",
          "30 22 * * *",
          "30 4 * * 1",
        ],
      },
      "limits": { "cpu_ms": 300000, "subrequests": 50000 },
    },
  },
}
