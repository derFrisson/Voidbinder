// Cloudflare config for voidbinder.de. `astro build` reads this file (CLOUDFLARE_ENV selects
// the environment) and writes the flattened deploy config under dist/ (dist/client/wrangler.json for static output, dist/server once there are on-demand routes), which
// `wrangler deploy` picks up via .wrangler/deploy/config.json. See docs/environments.md.
//
// Bindings are not inherited by environments, so the waitlist bindings (docs/site/waitlist.md)
// are repeated in every env. The top level is what `astro dev` / `wrangler dev` use locally.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "152a1fcd0eebb96d1bc30d14b5a6af58",
  "name": "voidbinder-site",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
  },
  "workers_dev": false,
  "vars": { "SITE_URL": "http://localhost:4321" },
  // Locally from .dev.vars (see .dev.vars.example); deployed: wrangler secret put --env dev|prod.
  "secrets": { "required": ["UNSUBSCRIBE_SECRET"] },
  // Local Postgres from the root docker-compose.yml.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
    },
  ],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@voidbinder.de"] }],
  "ratelimits": [
    { "name": "RL_WAITLIST", "namespace_id": "1700", "simple": { "limit": 5, "period": 60 } },
  ],
  "env": {
    "dev": {
      "name": "voidbinder-site-dev",
      "workers_dev": true,
      "vars": { "SITE_URL": "https://voidbinder-site-dev.frisson.workers.dev" },
      "secrets": { "required": ["UNSUBSCRIBE_SECRET"] },
      // Placeholder: replace with the id from `wrangler hyperdrive create voidbinder-dev ...`.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000",
          "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
        },
      ],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@voidbinder.de"] }],
      "ratelimits": [
        { "name": "RL_WAITLIST", "namespace_id": "1701", "simple": { "limit": 5, "period": 60 } },
      ],
    },
    "prod": {
      "name": "voidbinder-site",
      "workers_dev": false,
      "routes": [
        { "pattern": "voidbinder.de", "custom_domain": true },
        { "pattern": "www.voidbinder.de", "custom_domain": true },
      ],
      "vars": { "SITE_URL": "https://voidbinder.de" },
      "secrets": { "required": ["UNSUBSCRIBE_SECRET"] },
      // Placeholder: replace with the id from `wrangler hyperdrive create voidbinder-prod ...`.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000",
          "localConnectionString": "postgres://voidbinder:voidbinder@localhost:5434/voidbinder",
        },
      ],
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["hello@voidbinder.de"] }],
      "ratelimits": [
        { "name": "RL_WAITLIST", "namespace_id": "1702", "simple": { "limit": 5, "period": 60 } },
      ],
    },
  },
}
