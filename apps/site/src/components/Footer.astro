---
import { legalPath, links, t, type Locale } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const footerLinks = [
  { href: legalPath(locale, 'imprint'), label: d.footer.imprint },
  { href: legalPath(locale, 'privacy'), label: d.footer.privacy },
  { href: links.github, label: d.footer.github },
  { href: links.twitch, label: d.footer.twitch },
];
---

<footer class="footer" aria-label={d.a11y.footer}>
  <div class="wrap">
    <div class="f-top">
      <Logo href={`/${locale}/`} label={d.a11y.home} />
      <ul class="f-links">
        {
          footerLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="powered">{d.footer.poweredBy} <a href={links.voidcom}>Voidcom</a></p>
    </div>
    <div class="rights">
      <p>{d.footer.trademarks}</p>
      <p>{d.footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 40px 48px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 14.5px;
  }

  .wrap {
    display: grid;
    gap: 22px;
  }

  .f-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }

  .f-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .f-links a {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    font-weight: 500;
    text-decoration: none;
  }

  .f-links a:hover,
  .powered a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .powered {
    margin-left: auto;
    color: var(--ink-3);
    font: 500 13.5px/1 var(--f-body);
  }

  .powered a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ink-2);
    font-weight: 600;
    text-decoration: none;
  }

  .rights {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--ink-3);
    font-size: 13px;
  }

  @media (max-width: 640px) {
    .powered {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
