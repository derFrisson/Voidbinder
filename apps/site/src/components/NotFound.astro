---
// The 404 page body for /de/404, /en/404 and the root /404. The copy lives here, not in the
// i18n dictionaries, because no other page needs it.
import type { Locale } from '../i18n';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = {
  de: {
    title: 'Seite nicht gefunden · Voidbinder',
    description: 'Diese Seite gibt es auf voidbinder.de nicht.',
    heading: 'Diese Tasche ist leer.',
    lede: 'Die Seite, die du suchst, gibt es nicht oder nicht mehr. Vielleicht ist der Link veraltet.',
    home: 'Zur Startseite',
    other: { href: '/en/', label: 'English version', lang: 'en' },
  },
  en: {
    title: 'Page not found · Voidbinder',
    description: 'This page does not exist on voidbinder.de.',
    heading: 'This pocket is empty.',
    lede: 'The page you are looking for does not exist, or no longer does. The link may be out of date.',
    home: 'Back to the start page',
    other: { href: '/de/', label: 'Deutsche Version', lang: 'de' },
  },
}[locale];
---

<Base locale={locale} title={copy.title} description={copy.description} noindex>
  <section class="wrap intro not-found" aria-labelledby="not-found-title">
    <div class="pocket" aria-hidden="true"><span></span></div>
    <h1 id="not-found-title">{copy.heading}</h1>
    <p class="lead">{copy.lede}</p>
    <div class="actions">
      <a class="btn btn--primary" href={`/${locale}/`}>{copy.home}<Icon name="arrow" /></a>
      <a class="btn btn--ghost" href={copy.other.href} hreflang={copy.other.lang} lang={copy.other.lang}
        >{copy.other.label}</a
      >
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding-block: clamp(48px, 8vw, 112px);
  }

  /* An empty binder pocket on a yellow field: the card is missing. */
  .pocket {
    position: relative;
    width: 132px;
    aspect-ratio: 1;
    margin-bottom: 36px;
    border-radius: 32px;
    background-color: var(--pk);
    background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1.2px, transparent 1.4px);
    background-size: 14px 14px;
    rotate: -4deg;
  }

  .pocket span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 62px;
    aspect-ratio: 63 / 88;
    translate: -50% -50%;
    rotate: 8deg;
    border: 2.5px dashed #0b1433;
    border-radius: 7px;
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(2.2rem, 4.4vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
