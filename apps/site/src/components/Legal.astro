---
import { getEntry, render } from 'astro:content';
import { legalSlugs, type LegalPage, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
  page: LegalPage;
}

const { locale, page } = Astro.props;
// Kept here, not in the i18n dictionaries: these pages are the only user of the label.
const updatedLabel: Record<Locale, string> = { de: 'Stand:', en: 'Last updated:' };
const entry = await getEntry('legal', `${locale}/${legalSlugs[locale][page]}`);
if (!entry) throw new Error(`Missing legal content: ${locale}/${legalSlugs[locale][page]}`);
const { Content } = await render(entry);
const { title, description, updated } = entry.data;
---

<Base locale={locale} title={`${title} · Voidbinder`} description={description}>
  <section class="sec-legal">
    <div class="wrap">
      <article class="legal">
        <h1>{title}</h1>
        <p class="updated">{updatedLabel[locale]} {updated}</p>
        <Content />
      </article>
    </div>
  </section>
</Base>

<style>
  .sec-legal {
    padding-block: clamp(48px, 7vw, 96px);
  }

  /* One centered prose column on a surface panel. Markdown output is not scoped, hence :global. */
  .legal {
    max-width: 72ch;
    margin-inline: auto;
    padding: clamp(24px, 5vw, 56px);
    overflow-wrap: anywhere;
    border-radius: 30px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .updated {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: var(--space-4);
    color: var(--ink-2);
    font: 600 13px/1 var(--f-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .updated::before {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--pk);
  }

  .legal :global(h2) {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .legal :global(h3) {
    margin-top: var(--space-6);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .legal :global(p),
  .legal :global(ul) {
    margin-top: var(--space-4);
    color: var(--ink-2);
  }

  .legal :global(strong) {
    color: var(--ink);
  }

  .legal :global(a) {
    color: var(--blue-ink);
    text-underline-offset: 3px;
  }

  .legal :global(h1 + p),
  .legal :global(.updated + p) {
    margin-top: var(--space-6);
  }

  .legal :global(h2 + p),
  .legal :global(h3 + p),
  .legal :global(h2 + ul),
  .legal :global(h3 + ul) {
    margin-top: var(--space-3);
  }

  .legal :global(ul) {
    padding-left: var(--space-5);
    list-style: disc;
  }

  .legal :global(li + li) {
    margin-top: var(--space-2);
  }

  .legal :global(li::marker) {
    color: var(--ink-3);
  }
</style>
