---
// The icon set of the mockup: 24 px line icons in currentColor, inline so every page can use them.
const paths = {
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  chip: '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M9 15.5h6M10 6h4"/><rect x="9" y="9" width="6" height="4" rx="1"/>',
  offline:
    '<path d="M2.5 8.5a14 14 0 0 1 4.6-2.8M10.5 5.1a14 14 0 0 1 11 3.4M5.5 12a9 9 0 0 1 3.6-2M14.6 10.2A9 9 0 0 1 18.5 12M9 15.5a4.5 4.5 0 0 1 6 0"/><circle cx="12" cy="19" r="1" fill="currentColor"/><path d="M3 3l18 18"/>',
  layers: '<path d="M12 3l9 5-9 5-9-5z"/><path d="M3 13l9 5 9-5"/>',
  stack: '<rect x="7" y="3" width="12" height="15" rx="2"/><path d="M4 7v11a3 3 0 0 0 3 3h9"/>',
  trend: '<path d="M3 17l5-5 4 3 8-8"/><path d="M15 7h5v5"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5" stroke-width="3"/>',
};

interface Props {
  name: keyof typeof paths;
  class?: string;
}
const { name, class: className } = Astro.props;
const width = name === 'arrow' || name === 'code' ? 2 : 1.8;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width={width}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
