---
import { t, type Locale } from '../../i18n';
import Binder from '../art/Binder.astro';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale).games;
---

<section id="games" class="section wrap" aria-labelledby="games-title">
  <div class="section-head">
    <p class="label">{d.label}</p>
    <h2 id="games-title" class="display-m">{d.title}</h2>
    <p class="lede">{d.lede}</p>
  </div>
  <div class="split">
    <ul class="rows games">
      {
        d.list.map((g) => (
          <li>
            <span class="title">{g.name}</span>
            <span class="muted small">{g.note}</span>
          </li>
        ))
      }
    </ul>
    <Binder label={d.art} />
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .games li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  @media (max-width: 899px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      margin-top: var(--space-7);
    }
  }
</style>
