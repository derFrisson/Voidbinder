---
import { t, type Locale } from '../../i18n';
import Phone from '../art/Phone.astro';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale).deck;
// A wireframe deck list: count, a name bar of some length, and how many copies are missing.
const rows = [
  { count: 4, len: 'l', missing: 0 },
  { count: 4, len: 'm', missing: 0 },
  { count: 3, len: 'l', missing: 0 },
  { count: 2, len: 's', missing: 1 },
  { count: 4, len: 'm', missing: 0 },
  { count: 3, len: 's', missing: 0 },
  { count: 2, len: 'l', missing: 2 },
  { count: 1, len: 'm', missing: 0 },
];
---

<section class="section wrap" aria-labelledby="deck-title">
  <div class="section-head">
    <p class="label">{d.label}</p>
    <h2 id="deck-title" class="display-m">{d.title}</h2>
    <p class="lede">{d.lede}</p>
  </div>
  <div class="split">
    <dl class="facts">
      {
        d.facts.map((f) => (
          <>
            <dt>{f.term}</dt>
            <dd>{f.value}</dd>
          </>
        ))
      }
    </dl>
    <div class="visual">
      <Phone label={d.art}>
        <div class="deck">
          <div class="deck-head">
            <span class="title">{d.screen.title}</span>
            <span class="label">60</span>
          </div>
          <ul class="list" aria-hidden="true">
            {
              rows.map((r) => (
                <li class:list={{ 'is-missing': r.missing > 0 }}>
                  <span class="count num">{r.count}×</span>
                  <span class:list={['name', r.len]} />
                  <span class="state">
                    {r.missing > 0 ? `${d.screen.missing} ${r.missing}` : d.screen.owned}
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="summary">{d.screen.summary}</p>
        </div>
      </Phone>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .visual {
    display: flex;
    justify-content: center;
    padding-block: var(--space-6);
    border-block: 1px solid var(--outline);
  }

  .deck {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-3) var(--space-4) var(--space-4);
  }

  .deck-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--outline-hover);
  }

  .deck-head .title {
    font-size: var(--text-body);
  }

  .list li {
    display: grid;
    grid-template-columns: 2.2em 1fr auto;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    border-bottom: 1px solid var(--outline);
    font-size: var(--text-small);
  }

  .count {
    color: var(--on-surface-muted);
  }

  .name {
    height: 6px;
    border-radius: 1px;
    background: var(--outline-hover);
  }

  .name.l {
    width: 88%;
  }
  .name.m {
    width: 66%;
  }
  .name.s {
    width: 44%;
  }

  .state {
    color: var(--on-surface-dim);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: var(--label-tracking);
    text-transform: uppercase;
  }

  .is-missing .state {
    color: var(--primary);
  }

  .summary {
    margin-top: auto;
    padding-top: var(--space-4);
    color: var(--primary);
    font-size: var(--text-small);
    font-weight: 500;
  }

  @media (max-width: 899px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      margin-top: var(--space-7);
    }

    .visual {
      order: -1;
    }
  }
</style>
