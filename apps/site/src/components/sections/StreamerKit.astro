---
import { links, t, type Locale } from '../../i18n';
import Arrow from '../Arrow.astro';
import Card from '../art/Card.astro';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale).streamer;
const packs = Array.from({ length: 10 }, (_, i) => i < 3);
---

<section class="section wrap" aria-labelledby="streamer-title">
  <div class="section-head">
    <p class="label">{d.label}</p>
    <h2 id="streamer-title" class="display-m">{d.title}</h2>
    <p class="lede">{d.lede}</p>
    <p>
      <a class="link-arrow" href={links.twitch}>{d.link}<Arrow /></a>
    </p>
  </div>

  <div class="frame" role="img" aria-label={d.art}>
    <div class="pile" aria-hidden="true">
      <Card class="p1" />
      <Card class="p2" />
      <Card class="p3" variant="glass" />
    </div>
    <p class="chip live"><span class="dot"></span>{d.overlay.live}</p>
    <div class="pack glass">
      <span class="label">{d.overlay.pack}</span>
      <span class="ticks">{packs.map((done) => <i class:list={{ done }} />)}</span>
    </div>
    <div class="pull glass">
      <Card class="pull-card" variant="accent" />
      <span class="pull-text">
        <span class="label">{d.overlay.last}</span>
        <span class="title num">{d.overlay.lastValue}</span>
      </span>
    </div>
    <div class="total glass">
      <span class="label">{d.overlay.total}</span>
      <span class="headline num">{d.overlay.totalValue}</span>
    </div>
  </div>
</section>

<style>
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    margin-top: var(--space-8);
    overflow: hidden;
    border: 1px solid var(--outline-hover);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .pile {
    --w: clamp(72px, 14%, 180px);
    position: absolute;
    left: calc(50% - var(--w) / 2);
    top: 50%;
    width: var(--w);
    transform: translateY(-50%);
  }

  .pile > :global(.card) {
    width: 100%;
  }

  .pile > :global(.p1),
  .pile > :global(.p2) {
    position: absolute;
    inset: 0;
  }

  .pile > :global(.p1) {
    transform: rotate(-9deg) translateX(-18%);
  }

  .pile > :global(.p2) {
    transform: rotate(7deg) translateX(16%);
  }

  .frame > .live,
  .pack,
  .pull,
  .total {
    position: absolute;
  }

  .live {
    top: 4%;
    left: 2.5%;
  }

  .pack {
    top: 4%;
    right: 2.5%;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .ticks {
    display: flex;
    gap: 3px;
  }

  .ticks i {
    width: 10px;
    height: 4px;
    background: var(--outline-hover);
  }

  .ticks i.done {
    background: var(--primary);
  }

  .pull {
    bottom: 5%;
    left: 2.5%;
    display: flex;
    align-items: flex-end;
    gap: var(--space-4);
    padding: var(--space-3);
  }

  .pull > :global(.pull-card) {
    width: clamp(36px, 6vw, 72px);
  }

  .pull-text,
  .total {
    display: grid;
    gap: var(--space-1);
  }

  .total {
    right: 2.5%;
    bottom: 5%;
    padding: var(--space-3) var(--space-4);
    text-align: right;
  }

  @media (max-width: 639px) {
    .frame {
      aspect-ratio: 4 / 5;
      margin-top: var(--space-7);
    }

    .pile {
      --w: 34%;
    }

    .pack .label,
    .pull-text .label,
    .total .label {
      font-size: 10px;
    }

    .total .headline {
      font-size: var(--text-title);
    }
  }
</style>
