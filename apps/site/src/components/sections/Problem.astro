---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale).problem;
---

<section class="section wrap" aria-labelledby="problem-title">
  <div class="section-head">
    <p class="label">{d.label}</p>
    <h2 id="problem-title" class="display-m">{d.title}</h2>
    <p class="lede">{d.lede}</p>
  </div>
  <dl class="rows problems">
    {
      d.rows.map((r) => (
        <div class="row">
          <dt class="title">{r.term}</dt>
          <dd class="muted">{r.text}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .problems {
    margin-top: var(--space-8);
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-3) var(--space-6);
  }

  .row dd {
    max-width: 40em;
  }

  @media (max-width: 759px) {
    .problems {
      margin-top: var(--space-7);
    }

    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
