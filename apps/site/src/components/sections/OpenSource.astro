---
import { links, t, type Locale } from '../../i18n';
import Icon from '../Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale).openSource;
---

<section class="os sec" id="open-source" aria-labelledby="os-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="eyebrow">{d.label}</span>
        <h2 id="os-title" class="h2">{d.title}</h2>
      </div>
      <p class="lead">{d.lede}</p>
    </div>
    <div class="plans">
      <article class="plan plan--self">
        <p class="plan-label">{d.self.label}</p>
        <h3>{locale === 'de' ? '0\u00a0€' : '€0'}</h3>
        <p>{d.self.text}</p>
        <p class="term">
          <span>$</span> git clone voidbinder<br /><span>$</span> <b>docker compose up -d</b>
        </p>
        <a class="btn btn--ghost" href={links.github}><Icon name="code" />{d.self.link}</a>
      </article>
      <article class="plan plan--host">
        <p class="plan-label">{d.hosted.label}</p>
        <h3>{d.hosted.price} <span class="soft">{d.hosted.period}</span></h3>
        <p>{d.hosted.text}</p>
        <ul class="checks">
          {d.hosted.checks.map((c) => <li>{c}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .os {
    padding-top: 0;
  }

  .eyebrow {
    --dot: var(--ink);
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
    padding: clamp(24px, 3.4vw, 44px);
    border-radius: 30px;
  }

  .plan--self {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .plan--host {
    position: relative;
    overflow: hidden;
    background: var(--ink);
    color: var(--bg);
  }

  .plan--host::after {
    content: '';
    position: absolute;
    top: -18%;
    right: -12%;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--blue);
    opacity: 0.9;
  }

  .plan > * {
    position: relative;
    z-index: 1;
  }

  .plan-label {
    font: 600 13px/1 var(--f-display);
    letter-spacing: 0.08em;
    opacity: 0.7;
    text-transform: uppercase;
  }

  h3 {
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    font-weight: 700;
    letter-spacing: -0.045em;
  }

  .soft {
    opacity: 0.55;
  }

  /* Dark: the card is light, so the faded span overlaps the blue circle at 2.2:1. 0.9 gives 3:1
     (large text) on the circle and keeps a slight fade on the card. */
  @media (prefers-color-scheme: dark) {
    .soft {
      opacity: 0.9;
    }
  }

  .plan p:not(.plan-label, .term) {
    max-width: 30em;
    font-size: 16.5px;
    opacity: 0.85;
  }

  .term {
    margin-top: auto;
    overflow-x: auto;
    padding: 16px 18px;
    border-radius: 16px;
    background: var(--surface-2);
    color: var(--ink-2);
    font: 500 14px/1.7 var(--f-mono);
  }

  .term b {
    color: var(--blue-ink);
    font-weight: 600;
  }

  .checks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }

  .checks li {
    padding: 10px 13px;
    border-radius: 99px;
    background: color-mix(in srgb, var(--bg) 12%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--bg) 22%, transparent);
    font: 600 13.5px/1 var(--f-display);
  }

  .plan .btn {
    align-self: flex-start;
  }

  @media (max-width: 760px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
