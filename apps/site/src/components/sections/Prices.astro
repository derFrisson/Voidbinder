---
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale).prices;
const active = 2; // the variant the chart shows

// Example series for the quiet single-line chart (90 days, 2.90 to 3.80); not market data.
const series = [2.9, 2.95, 2.88, 3.0, 3.1, 3.05, 3.2, 3.15, 3.3, 3.45, 3.4, 3.55, 3.5, 3.7, 3.8];
const [w, h, pad] = [480, 120, 6];
const [min, max] = [Math.min(...series), Math.max(...series)];
const pts = series.map((v, i): [number, number] => [
  pad + (i * (w - 2 * pad)) / (series.length - 1),
  pad + ((max - v) * (h - 2 * pad)) / (max - min),
]);
const path = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const last = pts.at(-1) ?? [0, 0];
---

<section id="prices" class="section wrap" aria-labelledby="prices-title">
  <div class="section-head">
    <p class="label">{d.label}</p>
    <h2 id="prices-title" class="display-m">{d.title}</h2>
    <p class="lede">{d.lede}</p>
  </div>

  <div class="board">
    <p class="label board-label">{d.variantsLabel}</p>
    <ul class="variants">
      {
        d.variants.map((v, i) => (
          <li class:list={['variant', { 'is-active': i === active }]}>
            <span class:list={['card-shape', 'thumb', { 'is-accent': i === active }]} />
            <span class="name">{v.name}</span>
            <span class="price num">{v.price}</span>
          </li>
        ))
      }
    </ul>

    <div class="detail">
    <figure class="chart">
      <svg viewBox={`0 0 ${w} ${h}`} role="img" aria-label={d.chartLabel}>
        <path class="base" d={`M0 ${h - 0.5}H${w}`}></path>
        <path class="line" d={path}></path>
        <rect class="last" x={last[0] - 3} y={last[1] - 3} width="6" height="6"></rect>
      </svg>
      <figcaption class="caption">
        <span class="label">{d.chartSource}</span>
        <span class="chip">{d.chartNote}</span>
      </figcaption>
    </figure>

    <ul class="sources" aria-label={d.sourcesLabel}>
      {
        d.sources.map((s) => (
          <li>
            <span>{s.name}</span>
            <span class="muted small">{s.note}</span>
          </li>
        ))
      }
    </ul>
    </div>
  </div>
</section>

<style>
  .board {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .board-label {
    padding-top: var(--space-3);
  }

  .variants {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--outline);
    border-left: 1px solid var(--outline);
  }

  .variant {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-4);
    border-right: 1px solid var(--outline);
    border-bottom: 1px solid var(--outline);
  }

  .variant.is-active {
    box-shadow: inset 0 2px 0 var(--primary);
    background: var(--surface);
  }

  .thumb {
    grid-row: 1 / 3;
    width: 28px;
  }

  .name {
    color: var(--on-surface-muted);
    font-size: var(--text-small);
  }

  .is-active .name {
    color: var(--on-surface);
  }

  .price {
    font-weight: 500;
  }

  .detail {
    display: grid;
    grid-column: 2;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-6);
  }

  .chart svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .chart path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .base {
    stroke: var(--outline);
  }

  .line {
    stroke: var(--on-surface-muted);
    stroke-width: 1.5;
  }

  .last {
    fill: var(--primary);
  }

  .caption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .sources {
    border-top: 1px solid var(--outline);
  }

  .sources li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--outline);
  }

  @media (max-width: 899px) {
    .board {
      grid-template-columns: 1fr;
      margin-top: var(--space-7);
    }

    .board-label {
      display: none;
    }

    .detail {
      grid-column: 1;
      grid-template-columns: 1fr;
    }

    .variants {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
