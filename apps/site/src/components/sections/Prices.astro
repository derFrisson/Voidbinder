---
import { money, t, type Locale } from '../../i18n';
import Card from '../art/Card.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale).prices;
// The quiet 90-day line of the mockup: one trend, no axes or candles.
const line =
  'M0 118 L13 114 L26 119 L39 110 L52 112 L65 105 L78 108 L91 102 L104 106 L117 99 L130 103 L143 96 L156 98 L169 104 L182 100 L195 93 L208 96 L221 90 L234 93 L247 87 L260 92 L273 97 L286 94 L299 88 L312 84 L325 89 L338 82 L351 79 L364 83 L377 77 L390 81 L403 75 L416 72 L429 76 L442 70 L455 67 L468 72 L481 66 L494 63 L507 68 L520 61 L533 58 L546 63 L559 57 L572 55 L585 59 L600 54';
---

<section class="prices-sec sec" id="prices" aria-labelledby="prices-title">
  <div class="wrap">
    <div>
      <span class="eyebrow">{d.label}</span>
      <h2 id="prices-title" class="h2">{d.title}</h2>
      <p class="lead">{d.lede}</p>
      <div class="worth">
        <p class="worth-label">{d.worth}</p>
        <p class="worth-value">{money(locale, 1284.5)}</p>
        <p class="meta">
          <span>{d.count}</span><span><b>+{money(locale, 38.2)}</b> {d.period}</span>
        </p>
      </div>
      <p class="fine">{d.fine}</p>
    </div>
    <div class="panel">
      <div class="panel-top">
        <div aria-hidden="true"><Card kind="fox" locale={locale} /></div>
        <div>
          <h3>Glimmerfuchs</h3>
          <p class="sub">Funkenflug · 042/198 · Holo · NM</p>
          <p class="src">
            <span>Cardmarket <b>{money(locale, 3.2)}</b></span>
            <span>TCGplayer <b>{money(locale, 3.6, 'USD')}</b></span>
          </p>
        </div>
      </div>
      <div class="chart">
        <p class="chart-h"><span>{d.chartTitle}</span><span>{d.chartSource}</span></p>
        <svg viewBox="0 0 600 150" role="img" aria-label={d.chartLabel}>
          <defs>
            <linearGradient id="g-area" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" class="area-top"></stop>
              <stop offset="1" class="area-bottom"></stop>
            </linearGradient>
          </defs>
          <g class="grid"><path d="M0 30 H600"></path><path d="M0 125 H600"></path></g>
          <text x="0" y="22">{money(locale, 3.4)}</text>
          <text x="0" y="116">{money(locale, 2.8)}</text>
          <path d={`${line} V150 H0Z`} fill="url(#g-area)"></path>
          <path d={line} class="trend"></path>
          <circle cx="600" cy="54" r="5.5" class="dot"></circle>
        </svg>
        <p class="chart-x">
          <span>{d.chartStart}</span><span>{d.chartEnd} {money(locale, 3.2)}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .wrap {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 5vw, 80px);
    align-items: center;
  }

  .eyebrow {
    --dot: var(--ok);
  }

  .h2 {
    margin-top: 18px;
  }

  .lead {
    margin-top: 20px;
  }

  .worth {
    margin-top: 40px;
    padding: 26px 28px;
    border-radius: 24px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .worth-label {
    color: var(--ink-3);
    font: 600 13px/1 var(--f-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .worth-value {
    margin-top: 12px;
    font: 700 clamp(2.4rem, 4.4vw, 3.6rem) / 1 var(--f-display);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.05em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 14px;
    color: var(--ink-2);
    font: 500 14px/1.3 var(--f-body);
  }

  .meta b {
    color: var(--ok-ink);
    font-family: var(--f-mono);
    font-weight: 600;
  }

  .fine {
    max-width: 40em;
    margin-top: 16px;
    color: var(--ink-3);
    font-size: 13px;
  }

  .panel {
    min-width: 0;
    padding: clamp(18px, 2.6vw, 30px);
    border-radius: 30px;
    background: var(--surface);
    box-shadow:
      var(--shadow),
      inset 0 0 0 1px var(--line);
  }

  .panel-top {
    display: grid;
    grid-template-columns: clamp(96px, 22%, 150px) 1fr;
    gap: clamp(16px, 2.4vw, 28px);
    align-items: center;
  }

  h3 {
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
  }

  .sub {
    margin-top: 6px;
    color: var(--ink-3);
    font: 500 13.5px/1.4 var(--f-mono);
  }

  .src {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .src span {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 14px;
    background: var(--surface-2);
    color: var(--ink-2);
    font: 600 13.5px/1 var(--f-display);
  }

  .src b {
    color: var(--ink);
    font: 700 18px/1 var(--f-mono);
    letter-spacing: -0.03em;
  }

  .chart {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  .chart-h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    color: var(--ink-2);
    font: 600 13.5px/1 var(--f-display);
  }

  .chart-h span:last-child {
    color: var(--ink-3);
    font: 500 12.5px/1 var(--f-mono);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 14px;
    overflow: visible;
  }

  .grid {
    stroke: var(--line);
    stroke-dasharray: 3 5;
    stroke-width: 1;
  }

  text {
    fill: var(--ink-3);
    font: 400 16px var(--f-mono);
  }

  .area-top {
    stop-color: var(--blue-ink);
    stop-opacity: 0.16;
  }

  .area-bottom {
    stop-color: var(--blue-ink);
    stop-opacity: 0;
  }

  .trend {
    fill: none;
    stroke: var(--blue-ink);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.4;
  }

  .dot {
    fill: var(--surface);
    stroke: var(--blue-ink);
    stroke-width: 2.6;
  }

  .chart-x {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    color: var(--ink-3);
    font: 500 12px/1 var(--f-mono);
  }

  @media (max-width: 960px) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }
</style>
