---
import { env } from 'cloudflare:workers';
import { legalPath, t, type Locale } from '../../i18n';
import Card from '../art/Card.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale).waitlist;
const e = d.errors;
const done = t(locale).status.pending;
// The public sitekey of the one Turnstile widget (wrangler var, per environment, read at build).
const siteKey = env.TURNSTILE_SITE_KEY;
// Contract with VB-17 (docs/site/waitlist.md): POST /api/waitlist, form-encoded (no JavaScript:
// a 303 to the status pages) or JSON (the script below: answers shown inline).
---

<section id="waitlist" class="wl" aria-labelledby="waitlist-title">
  <div class="wrap">
    <div class="wl-card">
      <div>
        <h2 id="waitlist-title" class="h2">{d.title}</h2>
        <p class="lead">{d.lede}</p>
        <form id="waitlist-form" method="post" action="/api/waitlist" data-sending={d.sending}>
          <div class="fields">
            <input type="hidden" name="locale" value={locale} />
            <div class="field-row">
              <label class="visually-hidden" for="waitlist-email">{d.emailLabel}</label>
              <input
                id="waitlist-email"
                type="email"
                name="email"
                required
                maxlength="254"
                autocomplete="email"
                inputmode="email"
                placeholder={d.emailPlaceholder}
              />
              <button class="btn btn--primary" type="submit">{d.submit}</button>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="waitlist-website">{d.honeypot}</label>
              <input id="waitlist-website" type="text" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <div class="consent">
              <input id="waitlist-consent" type="checkbox" name="consent" value="on" required />
              <label for="waitlist-consent">
                {d.consentBefore}<a href={legalPath(locale, 'privacy')}>{d.consentLink}</a>{d.consentAfter}
              </label>
            </div>
            <div
              class="turnstile"
              role="group"
              aria-label={d.turnstileLabel}
              data-sitekey={siteKey}
              data-language={locale}
            >
              <noscript>{d.turnstileNoscript}</noscript>
            </div>
            <p
              class="error"
              role="alert"
              data-email={e.email}
              data-consent={e.consent}
              data-rate={e.rate}
              data-turnstile={e.turnstile}
              data-turnstile-wait={e.turnstileWait}
              data-turnstile-load={e.turnstileLoad}
              data-server={e.server}
            >
            </p>
          </div>
          <div class="done" role="status" tabindex="-1" hidden>
            <p class="done-title">{done.title}</p>
            <p>{done.text}</p>
          </div>
        </form>
      </div>
      <div class="wl-art" aria-hidden="true">
        <span class="field a"></span><span class="field b"></span><span class="field c"></span><span
          class="field d"></span>
        <Card kind="fox" locale={locale} />
      </div>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: without JavaScript the form posts natively and lands on a status page
  // (the Turnstile check then fails there: the widget needs JavaScript).
  const form = document.querySelector<HTMLFormElement>('#waitlist-form');
  const fields = form?.querySelector<HTMLElement>('.fields');
  const error = form?.querySelector<HTMLElement>('.error');
  const done = form?.querySelector<HTMLElement>('.done');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const box = form?.querySelector<HTMLElement>('.turnstile');

  interface TurnstileApi {
    render(container: HTMLElement, options: Record<string, unknown>): string;
    reset(widgetId: string): void;
  }
  const turnstileWindow = window as unknown as { turnstile?: TurnstileApi };

  if (form && fields && error && done && button && box) {
    const label = button.textContent;
    // Cloudflare Turnstile: the script loads when the form is about to scroll into view, so it
    // costs the rest of the page nothing. `token` is empty until the challenge is solved.
    let token = '';
    let widgetId: string | undefined;
    // The `normal` widget is 300 px wide and `flexible` has the same minimum; a phone narrower than
    // the form needs plus 300 px gets the `compact` one (150 x 140). Decided here, while the form
    // is still below the fold, so the CSS reserves the matching height before the widget loads.
    const size = box.clientWidth < 300 ? 'compact' : 'normal';
    box.dataset.size = size;
    let loadFailed = false;
    let requested = false;

    const loadWidget = () => {
      if (requested) return;
      requested = true;
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      script.async = true;
      script.onload = () => {
        widgetId = turnstileWindow.turnstile?.render(box, {
          sitekey: box.dataset.sitekey,
          size,
          theme: 'auto',
          language: box.dataset.language,
          callback: (value: string) => {
            token = value;
          },
          'expired-callback': () => {
            token = '';
          },
          'error-callback': () => {
            token = '';
          },
        });
      };
      script.onerror = () => {
        loadFailed = true;
        error.textContent = error.dataset.turnstileLoad ?? '';
      };
      document.head.appendChild(script);
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          loadWidget();
        },
        { rootMargin: '400px' },
      );
      observer.observe(form);
    } else {
      loadWidget();
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      // aria-disabled, not disabled: a disabled button drops keyboard focus to <body>.
      if (button.getAttribute('aria-disabled') === 'true') return;
      error.textContent = '';
      if (!token) {
        // Not solved yet (or expired): say so instead of posting a request that cannot pass.
        loadWidget();
        error.textContent =
          (loadFailed ? error.dataset.turnstileLoad : error.dataset.turnstileWait) ?? '';
        return;
      }
      const data = new FormData(form);
      button.setAttribute('aria-disabled', 'true');
      button.textContent = form.dataset.sending ?? label;
      let message = error.dataset.server;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify({
            email: data.get('email'),
            locale: data.get('locale'),
            consent: data.get('consent') === 'on',
            website: data.get('website') ?? '',
            'cf-turnstile-response': token,
          }),
        });
        if (res.ok) {
          fields.hidden = true;
          done.hidden = false;
          done.focus();
          return;
        }
        if (res.status === 400) {
          const body = (await res.json().catch(() => ({}))) as { error?: string };
          message =
            body.error === 'consent'
              ? error.dataset.consent
              : body.error === 'turnstile'
                ? error.dataset.turnstile
                : error.dataset.email;
        } else if (res.status === 429) {
          message = error.dataset.rate;
        }
      } catch {
        // Network failure: the server message below.
      }
      // A token works once: the next attempt needs a new challenge.
      token = '';
      if (widgetId) turnstileWindow.turnstile?.reset(widgetId);
      // The alert region is always in the DOM and only its text changes, so screen readers announce it.
      error.textContent = message ?? '';
      button.removeAttribute('aria-disabled');
      button.textContent = label;
    });
  }
</script>

<style>
  .wl {
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .wl-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 40px;
    align-items: center;
    overflow: hidden;
    padding: clamp(28px, 5vw, 72px);
    border-radius: 36px;
    background: var(--blue);
    color: #fff;
  }

  /* On the blue card the blue focus ring would vanish; white keeps 3:1. */
  .wl-card :focus-visible {
    outline-color: #fff;
  }

  .h2 {
    max-width: 11em;
  }

  .lead {
    margin-top: 18px;
    color: rgba(255, 255, 255, 0.85);
  }

  form {
    display: grid;
    max-width: 520px;
    margin-top: 30px;
  }

  .fields {
    display: grid;
    gap: 14px;
  }

  .fields[hidden],
  .done[hidden] {
    display: none;
  }

  .field-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .field-row input {
    flex: 1 1 220px;
    min-width: 0;
    min-height: 50px;
    padding: 17px 18px;
    border: 0;
    border-radius: 14px;
    background: #fff;
    box-shadow: inset 0 0 0 1.5px rgba(11, 20, 51, 0.08);
    color: #0b1433;
    font: 500 16px/1 var(--f-body);
  }

  .field-row input::placeholder {
    color: #5f6987;
  }

  .field-row input:focus-visible,
  .consent input:focus-visible {
    outline: 3px solid var(--pk);
    outline-offset: 2px;
  }

  .field-row .btn {
    background: var(--ink);
    box-shadow: none;
    color: var(--bg);
  }

  .field-row .btn:hover {
    background: #000;
  }

  /* The height of the `normal` widget (300 x 65; `compact` is 150 x 140), fixed: the form does not jump when it loads, and
     the line box around the widget's iframe cannot add a few pixels. */
  .turnstile {
    height: 65px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 14px;
    line-height: 1.5;
  }

  .turnstile[data-size='compact'] {
    height: 140px;
  }

  .consent {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 14px;
    line-height: 1.5;
  }

  .consent input {
    width: 20px;
    height: 20px;
    margin: 2px 0 0;
    accent-color: var(--pk);
    cursor: pointer;
  }

  .consent label {
    cursor: pointer;
  }

  .consent a {
    color: #fff;
    text-underline-offset: 3px;
  }

  /* Answers from the server: white on a lighter strip of the card, like the success panel. */
  .error,
  .done {
    padding: 16px 18px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.14);
    font: 600 16px/1.4 var(--f-display);
  }

  .error {
    box-shadow: inset 4px 0 0 var(--pk);
  }

  /* Empty live region: out of the grid flow, so it takes no gap until it has a message. */
  .error:empty {
    position: absolute;
    padding: 0;
  }

  .done {
    display: grid;
    gap: 6px;
  }

  .done:focus {
    outline: none;
  }

  .done-title {
    font-size: 17px;
  }

  .done p:not(.done-title) {
    font: 400 15px/1.5 var(--f-body);
    color: rgba(255, 255, 255, 0.88);
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .wl-art {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 420px;
    aspect-ratio: 1 / 1;
  }

  .field {
    position: absolute;
    border-radius: 32px;
    background-color: var(--c);
    background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1.2px, transparent 1.4px);
    background-size: 14px 14px;
  }

  .a {
    --c: var(--pk);
    top: 0;
    left: 0;
    width: 56%;
    height: 52%;
    rotate: -5deg;
  }

  .b {
    --c: var(--yg);
    top: 8%;
    right: 0;
    width: 44%;
    height: 44%;
    border-radius: 50%;
  }

  .c {
    --c: var(--mg);
    bottom: 0;
    left: 8%;
    width: 50%;
    height: 44%;
    rotate: 4deg;
  }

  .d {
    --c: var(--op);
    right: 4%;
    bottom: 4%;
    width: 40%;
    height: 40%;
  }

  .wl-art :global(.tc) {
    position: absolute;
    top: 24%;
    left: 31%;
    z-index: 2;
    width: 38%;
    rotate: -6deg;
  }

  @media (max-width: 860px) {
    .wl-card {
      grid-template-columns: 1fr;
    }

    .wl-art {
      justify-self: start;
      max-width: 300px;
    }
  }
</style>
