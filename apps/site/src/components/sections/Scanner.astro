---
import { t, type Locale } from '../../i18n';
import Phone from '../art/Phone.astro';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale).scanner;

// The card as the camera sees it: a tilted quad. Points inside it are placed bilinearly in
// card space (u across, v down, 0..1), so the art follows the card's tilt.
const [tl, tr, br, bl] = [
  [74, 52],
  [212, 66],
  [200, 262],
  [60, 246],
] as const;
const at = (u: number, v: number) => {
  const x = (1 - v) * ((1 - u) * tl[0] + u * tr[0]) + v * ((1 - u) * bl[0] + u * br[0]);
  const y = (1 - v) * ((1 - u) * tl[1] + u * tr[1]) + v * ((1 - u) * bl[1] + u * br[1]);
  return `${x.toFixed(1)},${y.toFixed(1)}`;
};
const quad = (u0: number, v0: number, u1: number, v1: number) =>
  [at(u0, v0), at(u1, v0), at(u1, v1), at(u0, v1)].join(' ');
const line = (u0: number, u1: number, v: number) => `M${at(u0, v)} L${at(u1, v)}`;
const zone = [0.08, 0.89, 0.4, 0.96] as const;
const corners = [tl, tr, br, bl];
---

<section id="scanner" class="section wrap" aria-labelledby="scanner-title">
  <div class="section-head">
    <p class="label">{d.label}</p>
    <h2 id="scanner-title" class="display-m">{d.title}</h2>
    <p class="lede">{d.lede}</p>
  </div>
  <div class="split">
    <div class="visual">
      <Phone label={d.art}>
        <div class="finder">
          <svg viewBox="0 0 272 320" aria-hidden="true">
            <path class="bracket" d="M20 44V20h24M228 20h24v24M252 276v24h-24M44 300H20v-24"></path>
            <polygon class="card" points={quad(0, 0, 1, 1)}></polygon>
            <path class="faint" d={line(0.09, 0.6, 0.06)}></path>
            <polygon class="faint" points={quad(0.09, 0.15, 0.91, 0.55)}></polygon>
            <path class="faint" d={`${line(0.09, 0.91, 0.64)} ${line(0.09, 0.75, 0.7)}`}></path>
            <polygon class="quad" points={quad(0, 0, 1, 1)}></polygon>
            {
              corners.map(([x, y]) => (
                <rect class="handle" x={x - 3} y={y - 3} width="6" height="6" />
              ))
            }
            <polygon class="zone" points={quad(...zone)}></polygon>
          </svg>
        </div>
        <div class="sheet glass">
          <p class="label sheet-status"><span class="dot"></span>{d.screen.status}</p>
          <p class="title code">{d.screen.code}</p>
          <span class="btn btn-primary btn-sm">{d.screen.action}</span>
        </div>
      </Phone>
    </div>
    <dl class="facts">
      {
        d.facts.map((f) => (
          <>
            <dt>{f.term}</dt>
            <dd>{f.value}</dd>
          </>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-8);
  }

  .visual {
    display: flex;
    justify-content: center;
    padding-block: var(--space-6);
    border-block: 1px solid var(--outline);
  }

  .finder {
    flex: 1;
    display: flex;
    align-items: center;
    background: var(--surface);
  }

  .finder svg {
    width: 100%;
  }

  .finder svg * {
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .bracket {
    stroke: var(--on-surface-muted);
    stroke-width: 1.5;
  }

  .card {
    fill: var(--bg);
    stroke: var(--outline-hover);
  }

  .faint {
    stroke: var(--outline-hover);
  }

  .quad {
    stroke: var(--primary);
    stroke-width: 1.5;
  }

  .handle {
    fill: var(--primary);
    stroke: none;
  }

  .zone {
    fill: var(--primary-faint);
    stroke: var(--primary);
  }

  .sheet {
    display: grid;
    gap: var(--space-2);
    margin: 0 var(--space-2) var(--space-2);
    padding: var(--space-4);
  }

  .sheet-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .code {
    font-size: var(--text-body);
  }

  .sheet .btn {
    justify-self: start;
    cursor: default;
  }

  @media (max-width: 899px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      margin-top: var(--space-7);
    }
  }
</style>
