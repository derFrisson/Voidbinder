---
import { links, t, type Locale } from '../../i18n';
import Arrow from '../Arrow.astro';
import CardFan from '../art/CardFan.astro';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale).hero;
---

<section class="hero wrap intro" aria-labelledby="hero-title">
  <h1 id="hero-title" class="display-l">{d.title}</h1>
  <p class="lede">{d.lede}</p>
  <div class="actions">
    <a class="btn btn-primary" href="#waitlist">{d.primary}<Arrow /></a>
    <a class="btn btn-outlined" href={links.github}>{d.secondary}</a>
  </div>
  <p class="status label"><span class="dot"></span>{d.status}</p>
  <p class="powered small">
    <a href={links.voidcom}>{d.poweredBy}</a>
  </p>
  <div class="art">
    <CardFan label={d.art} />
  </div>
</section>

<style>
  .hero {
    padding-top: var(--space-9);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .powered {
    margin-top: var(--space-3);
  }
  .powered a {
    color: var(--on-surface-dim);
  }
  .art {
    width: 100%;
    margin-top: var(--space-8);
    border-bottom: 1px solid var(--outline);
  }

  @media (max-width: 639px) {
    .hero {
      padding-top: var(--space-7);
    }

    .art {
      margin-top: var(--space-7);
    }
  }
</style>
