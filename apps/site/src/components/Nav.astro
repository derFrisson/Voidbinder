---
import { env } from 'cloudflare:workers';
import { locales, localePath, t, type Locale } from '../i18n';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const home = `/${locale}/`;
const links = [
  { href: `${home}#games`, label: d.nav.games },
  { href: `${home}#scanner`, label: d.nav.scanner },
  { href: `${home}#prices`, label: d.nav.prices },
  { href: `${home}#streamer`, label: d.nav.streamer },
];
const { pathname: path, search } = Astro.url;
const appUrl = env.PUBLIC_APP_URL;
---

<header class="nav">
  <nav class="wrap nav-inner" aria-label={d.a11y.nav}>
    <Logo href={home} label={d.a11y.home} />
    <ul class="nav-links">
      {
        links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))
      }
    </ul>
    <div class="nav-end">
      <ul class="lang" aria-label={d.a11y.language}>
        {
          locales.map((l) => (
            <li>
              <a
                href={localePath(path, l) + search}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? 'true' : undefined}
              >
                {l.toUpperCase()}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary cta" href={appUrl}
        ><span class="cta-long">{d.nav.cta}</span><span class="cta-short">{d.nav.ctaShort}</span></a
      >
    </div>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: var(--nav-height);
  }

  .nav-links {
    display: flex;
    gap: 26px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .nav-links a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: var(--ink-2);
    font: 500 15px/1 var(--f-body);
    text-decoration: none;
  }

  .nav-links a:hover,
  .lang a:hover {
    color: var(--ink);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .lang {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 32px;
    color: var(--ink-2);
    font: 600 13px/1 var(--f-display);
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lang a[aria-current] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--pk);
    text-decoration-thickness: 3px;
    text-underline-offset: 6px;
  }

  .cta {
    min-height: 0;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 14.5px;
  }

  .cta-short {
    display: none;
  }

  @media (max-width: 820px) {
    .nav-links {
      display: none;
    }

    .nav-end {
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .cta-long {
      display: none;
    }

    .cta-short {
      display: inline;
    }
  }

  /* 320 to 379 px: logo, language switch and button must fit without clipping (WCAG 1.4.10). */
  @media (max-width: 379px) {
    .nav-inner {
      gap: 12px;
    }

    .nav-end {
      gap: 4px;
    }
  }

  /* Below 360 px the mark alone is the logo; the link keeps its aria-label. */
  @media (max-width: 359px) {
    .nav :global(.wordmark) {
      display: none;
    }
  }
</style>
