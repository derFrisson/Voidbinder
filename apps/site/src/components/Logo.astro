---
// Voidbinder mark: a blue binder with three rings and a yellow card sliding out of it.
// The same drawing is public/favicon.svg.
interface Props {
  label: string;
  href: string;
}
const { label, href } = Astro.props;
---

<a class="brand" href={href} aria-label={label}>
  <svg class="mark" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
    <rect x="3" y="6" width="19" height="23" rx="4" fill="#1E48F5"></rect>
    <g fill="#F4F6FB"
      ><circle cx="6.5" cy="11.5" r="1.4"></circle><circle cx="6.5" cy="17.5" r="1.4"
      ></circle><circle cx="6.5" cy="23.5" r="1.4"></circle></g
    >
    <g transform="rotate(12 21 14)"
      ><rect
        x="13.5"
        y="2.5"
        width="14"
        height="19"
        rx="2.6"
        fill="#FFD447"
        stroke="#0B1433"
        stroke-width="1.6"></rect><rect
        x="16"
        y="5.5"
        width="9"
        height="6.5"
        rx="1"
        fill="#0B1433"
        opacity=".85"></rect></g
    >
  </svg>
  <span class="wordmark">Voidbinder</span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--ink);
    font: 700 21px/1 var(--f-display);
    letter-spacing: -0.035em;
    text-decoration: none;
  }

  .mark {
    flex: none;
    width: 30px;
    height: 30px;
  }
</style>
