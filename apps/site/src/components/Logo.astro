---
// Voidbinder mark: Voidcom's square pink mark with one card pocket cut into it (63:88).
interface Props {
  label: string;
  href: string;
}
const { label, href } = Astro.props;
---

<a class="logo" href={href} aria-label={label}>
  <svg class="mark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
    <rect width="24" height="24" rx="2" class="mark-square"></rect>
    <rect x="7" y="4.5" width="10" height="14" rx="1" class="mark-pocket"></rect>
  </svg>
  <span class="wordmark">Voidbinder</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--on-surface);
    text-decoration: none;
  }

  .logo:hover {
    color: var(--on-surface);
  }

  .mark-square {
    fill: var(--primary);
  }

  .mark-pocket {
    fill: var(--bg);
  }

  .wordmark {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
</style>
