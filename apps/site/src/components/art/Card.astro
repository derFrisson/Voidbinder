---
// One of the invented example cards, drawn in CSS and inline SVG (art in Sprite.astro). Never
// real card art, set symbols or logos. Names and numbers are made up and the same in every locale;
// type line and texts come from the dictionary. Sized by the parent: set a width on `.tc`.
import { t, type Locale } from '../../i18n';

const cards = {
  fox: { name: 'Glimmerfuchs', hp: '70', power: '30', number: '042/198', ruleNumber: '042/198' },
  warden: { name: 'Nebelwächter', number: 'NBW-017', ruleNumber: 'NBW-DE017' },
  coral: { name: 'Sturmkoralle', number: '118/274', ruleNumber: '118/274' },
  sail: { name: 'Salzwindsegler', hp: '5', number: 'SW1-031', ruleNumber: 'SW1-031' },
} as const;
const style = { fox: 'pk', warden: 'yg', coral: 'mg', sail: 'op' } as const;

interface Props {
  kind: keyof typeof cards;
  locale: Locale;
  /** Body text: the short flavor line, the longer rules text, or none. */
  text?: 'flavor' | 'rule' | 'none';
  /** Thumbnail: name bar, art and an empty text box, nothing else. */
  mini?: boolean;
  /** The light sweep on hover. */
  holo?: boolean;
  class?: string;
}
const { kind, locale, text = 'flavor', mini = false, holo = true, class: className } = Astro.props;
const card = cards[kind];
const copy = t(locale).cards[kind];
const hp = 'hp' in card ? card.hp : undefined;
const attack = 'attack' in copy && 'power' in card ? { name: copy.attack, power: card.power } : undefined;
const body = text === 'rule' && 'rule' in copy ? copy.rule : text === 'flavor' ? copy.flavor : undefined;
---

<div class:list={['tc', `tc--${style[kind]}`, className]}>
  <div class="tc-in">
    {
      mini ? (
        <>
          <div class="tc-top">&nbsp;</div>
          <div class="tc-art">
            <svg>
              <use href={`#art-${kind}`} />
            </svg>
          </div>
          <div class="tc-text" />
        </>
      ) : (
        <>
          <div class="tc-top">
            {card.name}
            {hp && <small>{hp}</small>}
          </div>
          <div class="tc-art">
            <svg>
              <use href={`#art-${kind}`} />
            </svg>
          </div>
          <div class="tc-type">{copy.type}</div>
          <div class="tc-text">
            {
              attack && (
                <b>
                  {attack.name}
                  <span>{attack.power}</span>
                </b>
              )
            }
            {body && <em>{body}</em>}
          </div>
          <div class="tc-foot">
            <span>{text === 'rule' ? card.ruleNumber : card.number}</span>
            <i />
          </div>
        </>
      )
    }
  </div>
  {holo && !mini && <span class="tc-holo" />}
  <slot />
</div>

<style>
  .tc {
    position: relative;
    isolation: isolate;
    aspect-ratio: 63 / 88;
    border-radius: 5.5% / 4%;
    background: var(--frame);
    box-shadow:
      0 14px 30px -14px rgba(11, 20, 51, 0.5),
      0 2px 4px rgba(11, 20, 51, 0.18);
    color: var(--card-ink);
    container-type: inline-size;
  }

  .tc-in {
    position: absolute;
    inset: 4cqw;
    display: flex;
    flex-direction: column;
    gap: 2.4cqw;
    padding: 3cqw;
    border-radius: 2.6cqw;
    background: var(--face);
  }

  .tc-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-inline: 0.6cqw;
    font: 700 7.4cqw/1.05 var(--f-display);
    letter-spacing: -0.02em;
  }

  .tc-top small {
    font: 600 5.2cqw/1 var(--f-mono);
  }

  .tc-art {
    aspect-ratio: 100 / 72;
    overflow: hidden;
    border-radius: 1.6cqw;
    box-shadow: 0 0 0 1.1cqw var(--artframe);
  }

  .tc-art svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tc-type {
    margin-top: 1cqw;
    padding: 1.3cqw 2.4cqw;
    border-radius: 1cqw;
    background: var(--bar);
    color: var(--bar-ink, inherit);
    font: 600 4.5cqw/1.2 var(--f-body);
  }

  .tc-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.6cqw;
    padding: 2.4cqw;
    border-radius: 1.2cqw;
    background: var(--box);
    color: var(--box-ink, inherit);
    font: 500 4.2cqw/1.3 var(--f-body);
  }

  .tc-text b {
    display: flex;
    justify-content: space-between;
    font: 700 4.8cqw/1.2 var(--f-display);
  }

  .tc-text em {
    opacity: 0.7;
    font-size: 3.9cqw;
  }

  .tc-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-inline: 0.6cqw;
    opacity: 0.85;
    font: 600 4cqw/1 var(--f-mono);
  }

  .tc-foot i {
    display: block;
    width: 3.4cqw;
    height: 3.4cqw;
    border-radius: 50%;
    background: currentColor;
  }

  .tc-holo {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    background: linear-gradient(
      115deg,
      transparent 28%,
      rgba(255, 255, 255, 0.55) 42%,
      rgba(150, 215, 255, 0.4) 48%,
      rgba(255, 170, 235, 0.35) 54%,
      transparent 68%
    );
    background-position: 100% 0;
    background-size: 260% 100%;
    mix-blend-mode: overlay;
    pointer-events: none;
    transition: background-position 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .tc:hover .tc-holo {
    background-position: 0 0;
  }

  .tc--pk {
    --frame: linear-gradient(155deg, #ffe36e, #f2b705 60%, #e7a400);
    --face: #fff8db;
    --bar: #ffe58c;
    --box: #fff1be;
    --artframe: #d99a00;
    --card-ink: #2b2100;
  }

  .tc--yg {
    --frame: linear-gradient(155deg, #4b3a73, #1b1233 70%);
    --face: linear-gradient(170deg, #5e44a8, #2d1e5c);
    --bar: rgba(214, 178, 92, 0.22);
    --bar-ink: #f2dea6;
    --box: #f0e5c8;
    --box-ink: #2a1e0e;
    --artframe: #c9a24a;
    --card-ink: #f6e9c2;
  }

  .tc--mg {
    --frame: #17130f;
    --face: linear-gradient(175deg, #ebcba2, #d7a36f);
    --bar: #f3dfc2;
    --box: #f6e9d4;
    --artframe: #6b4a2b;
    --card-ink: #2a1c10;
  }

  .tc--op {
    --frame: linear-gradient(155deg, #fbfaf6, #dcd9cf);
    --face: #ffffff;
    --bar: #e5413a;
    --bar-ink: #fff;
    --box: #fdedea;
    --artframe: #e5413a;
    --card-ink: #241312;
  }
</style>
