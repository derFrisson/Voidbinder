---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { locales, localePath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Defaults to the locale's site title and description. */
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const d = t(locale);
const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://voidbinder.de');
const canonical = new URL(path, site).href;
const pageTitle = title ?? d.meta.title;
const pageDescription = description ?? d.meta.description;
---

<!doctype html>
<html lang={d.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(path, l), site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Voidbinder" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={d.meta.ogLocale} />
    <meta name="theme-color" content="#080808" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <a class="skip btn btn-primary" href="#main">{d.a11y.skip}</a>
    <Nav locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 20;
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  main {
    padding-top: var(--nav-height);
  }

  main:focus {
    outline: none;
  }
</style>
