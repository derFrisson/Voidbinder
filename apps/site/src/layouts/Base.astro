---
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
import { plausibleOrigin } from '../analytics';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Defaults to the locale's site title and description. */
  title?: string;
  description?: string;
  /** Error pages: `noindex`, left out of the sitemap. */
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const d = t(locale);
const pageTitle = title ?? d.meta.title;
const pageDescription = description ?? d.meta.description;
// Self-hosted Plausible, prod only: the wrangler var PLAUSIBLE_HOST (docs/environments.md).
const plausible = plausibleOrigin(env.PLAUSIBLE_HOST);
---

<!doctype html>
<html lang={d.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo locale={locale} title={pageTitle} description={pageDescription} noindex={noindex} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {
      plausible && (
        <script is:inline defer data-domain={Astro.site?.hostname} src={`${plausible}/js/script.js`} />
      )
    }
  </head>
  <body>
    <a class="skip btn btn--primary" href="#main">{d.a11y.skip}</a>
    <Nav locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 60;
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
