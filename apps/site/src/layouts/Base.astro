---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Defaults to the locale's site title and description. */
  title?: string;
  description?: string;
  /** Error pages: `noindex`, left out of the sitemap. */
  noindex?: boolean;
}

const { locale, title, description, noindex = false } = Astro.props;
const d = t(locale);
const pageTitle = title ?? d.meta.title;
const pageDescription = description ?? d.meta.description;
const analyticsToken: string | undefined = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={d.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo locale={locale} title={pageTitle} description={pageDescription} noindex={noindex} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {
      // Cloudflare Web Analytics: cookieless, set per environment at build time (docs/environments.md).
      analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </head>
  <body>
    <a class="skip btn btn-primary" href="#main">{d.a11y.skip}</a>
    <Nav locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 20;
    transform: translateY(-200%);
  }

  .skip:focus-visible {
    transform: none;
  }

  main {
    padding-top: var(--nav-height);
  }

  main:focus {
    outline: none;
  }
</style>
