# Copy to /opt/plausible/.env (owner ubuntu, mode 600) and fill the two secrets on the VPS:
#   openssl rand -base64 48   -> SECRET_KEY_BASE (64 characters)
#   openssl rand -base64 32   -> TOTP_VAULT_KEY
# Never commit the real file.
BASE_URL=https://plausible.voidbinder.de
SECRET_KEY_BASE=
TOTP_VAULT_KEY=
# invite_only still lets the very first user register (Plausible's first-launch flow), then only
# invited users can.
DISABLE_REGISTRATION=invite_only
HTTP_PORT=8000
